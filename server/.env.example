# PostgreSQL database connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unimerch?schema=public"

# HTTP Port for Express backend server
PORT=3000

# Secret for session signing and cryptographic validation
SESSION_SECRET="unimerch-super-secret-session-key-change-in-production"

# Allowed CORS client origin
CORS_ORIGIN="http://localhost:5173"

# Node environment mode
NODE_ENV="development"

# Default seed password for seeded demo accounts (never commit real passwords)
SEED_PASSWORD="password123"
